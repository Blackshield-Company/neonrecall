# Copy to .env (or export) and adjust. Every setting has an offline-safe default.

# Storage: sqlite | postgres
NEONRECALL_STORE=postgres
NEONRECALL_PG_DSN=postgresql://neonrecall:neonrecall@localhost:5432/neonrecall
# NEONRECALL_SQLITE_PATH=neonrecall.db

# Embeddings: hash (offline) | openai (any OpenAI-compatible server, e.g. Ollama)
NEONRECALL_EMBED_BACKEND=openai
NEONRECALL_EMBED_BASE_URL=http://localhost:11434/v1
NEONRECALL_EMBED_MODEL=nomic-embed-text
# NEONRECALL_EMBED_API_KEY=

# Answers: extractive (offline) | openai
NEONRECALL_LLM_BACKEND=openai
NEONRECALL_LLM_BASE_URL=http://localhost:11434/v1
NEONRECALL_LLM_MODEL=llama3.1
# NEONRECALL_LLM_API_KEY=

# Reranking: none | lexical (offline) | http (POST {base_url}/rerank)
NEONRECALL_RERANK=lexical
